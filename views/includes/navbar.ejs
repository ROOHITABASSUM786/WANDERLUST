<style>
  .navbar.custom-navbar {
    background-color: #ffffff !important;
    box-shadow: 0 1px 8px rgba(0, 0, 0, 0.08) !important;
    border-bottom: none !important;
    padding: 12px 0 !important;
    height: auto !important;
  }

  .brand-icon {
    color: #FF385C !important;
    font-size: 2.2rem;
  }

  .brand-text {
    color: #FF385C !important;
    font-weight: 800;
    font-size: 1.35rem;
    letter-spacing: -0.6px;
  }

  .custom-nav-link {
    color: #222222 !important;
    font-weight: 500 !important;
    font-size: 15px !important;
    border-radius: 8px !important;
    padding: 8px 16px !important;
    text-decoration: none !important;
    transition: background-color 0.2s ease, color 0.2s ease !important;
  }

  .custom-nav-link:hover {
    background-color: #F7F7F7 !important;
    color: #222222 !important;
  }

  .search-form-container {
    border: 1px solid #DDDDDD;
    border-radius: 40px;
    padding: 4px 6px 4px 16px;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.1);
    background: #ffffff;
    transition: box-shadow 0.2s ease;
  }

  .search-form-container:hover {
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .search-icon-inside {
    color: #717171;
    font-size: 0.9rem;
    margin-right: 8px;
  }

  .search-inp-field {
    border: none;
    outline: none;
    box-shadow: none !important;
    font-size: 0.9rem;
    font-weight: 500;
    color: #222222;
    background: transparent;
    width: 170px;
  }

  .search-inp-field::placeholder {
    color: #717171;
    font-weight: 400;
  }

  .search-submit-btn {
    background-color: #FF385C !important;
    color: #ffffff !important;
    border-radius: 25px !important;
    padding: 6px 16px !important;
    font-weight: 600 !important;
    font-size: 0.85rem !important;
    border: none !important;
    transition: opacity 0.2s ease !important;
  }

  .search-submit-btn:hover {
    opacity: 0.95;
    color: #ffffff !important;
  }

  .secondary-nav-link {
    color: #717171 !important;
    font-size: 14px !important;
    font-weight: 500 !important;
    padding: 8px 14px !important;
    border-radius: 8px !important;
    text-decoration: none !important;
    transition: background-color 0.2s ease, color 0.2s ease !important;
  }

  .secondary-nav-link:hover {
    background-color: #F7F7F7 !important;
    color: #222222 !important;
  }

  .secondary-nav-btn {
    background: transparent !important;
    color: #717171 !important;
    border-radius: 20px !important;
    padding: 6px 12px !important;
    font-weight: 500 !important;
    font-size: 14px !important;
    border: 1px solid #DDDDDD !important;
    transition: all 0.2s ease !important;
  }

  .secondary-nav-btn:hover {
    background-color: #F7F7F7 !important;
    color: #222222 !important;
    border-color: #b0b0b0 !important;
  }

  .user-dropdown-btn {
    border-radius: 24px !important;
    padding: 6px 14px !important;
    border: 1px solid #DDDDDD !important;
    background-color: #ffffff !important;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08) !important;
    transition: box-shadow 0.2s ease, border-color 0.2s ease !important;
  }

  .user-dropdown-btn:hover,
  .user-dropdown-btn:focus {
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12) !important;
    border-color: #b0b0b0 !important;
  }

  .host-link {
    font-weight: 600;
    font-size: 14px;
    color: #222222 !important;
    padding: 10px 16px;
    border-radius: 22px;
    transition: background-color 0.2s ease;
    white-space: nowrap;
  }

  .host-link:hover {
    background-color: #F7F7F7;
    text-decoration: none;
  }
</style>
<nav class="navbar navbar-expand-md custom-navbar sticky-top">
  <div class="container-fluid site-wrapper">
    <a class="navbar-brand d-flex align-items-center gap-2" href="/listings">
      <i class="bi bi-geo-alt-fill" style="color: #FF385C; font-size: 24px;"></i>
      <span class="fw-bold" style="color: #FF385C; font-size: 20px;">wanderlust</span>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
      aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <div class="navbar-nav gap-1">
        <a class="custom-nav-link" href="/listings/favorites">Favorites</a>
      </div>

      <!-- Centered Search Bar + AI Assistant Button -->
      <div class="navbar-nav ms-auto d-flex align-items-center gap-2">
        <form class="search-form-container d-flex align-items-center me-1" role="search" action="/search" method="GET">
          <i class="fa-solid fa-magnifying-glass search-icon-inside"></i>
          <input class="search-inp-field" type="search" name="q" placeholder="Search destinations" />
          <button class="btn search-submit-btn" type="submit">Search</button>
        </form>
        <button class="btn secondary-nav-btn d-flex align-items-center gap-1 ms-1" type="button"
          data-bs-toggle="offcanvas" data-bs-target="#aiOffcanvas">
          <i class="fa-solid fa-wand-magic-sparkles me-1 text-secondary"></i> Ask Wanderlust
        </button>
      </div>

      <!-- Far-Right User Profile Section -->
      <div class="navbar-nav ms-auto d-flex align-items-center">
        <a class="nav-link me-2 host-link" href="/listings/new">Host with Wanderlust</a>

        <% if(!currUser){ %>
          <a class="custom-nav-link" aria-current="page" href="/signup">Sign up</a>
          <a class="custom-nav-link ms-1" href="/login">Log in</a>
          <% } %>

            <% if(currUser){ %>
              <div class="nav-item dropdown ms-2">
                <button class="btn user-dropdown-btn dropdown-toggle d-flex align-items-center gap-2" type="button"
                  data-bs-toggle="dropdown" aria-expanded="false">
                  <i class="bi bi-person-circle fs-5 text-secondary"></i>
                  <span class="fw-semibold text-dark">
                    <%= currUser.username %>
                  </span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2">
                  <li>
                    <a class="dropdown-item text-danger d-flex align-items-center gap-2" href="/logout">
                      <i class="fa-solid fa-right-from-bracket"></i> Log out
                    </a>
                  </li>
                </ul>
              </div>
              <% } %>
      </div>
    </div>
  </div>
</nav>
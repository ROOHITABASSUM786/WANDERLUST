<% layout("/layouts/boilerplate") -%>
<script>
    const listing = <%- JSON.stringify(listing) %>;
</script>

<style>
  .show-container {
    max-width: 900px;
    margin: 32px auto 64px auto;
    padding: 0 16px;
  }
  .show-title {
    font-size: 28px;
    font-weight: 700;
    color: #222222;
    margin-bottom: 6px;
    letter-spacing: -0.5px;
  }
  .show-location {
    color: #717171;
    font-size: 15px;
    font-weight: 500;
    margin-bottom: 20px;
  }
  .show-img-container {
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 20px;
    overflow: hidden;
    margin-bottom: 24px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  }
  .show-img-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .owner-pill {
    background: #F7F7F7;
    border-radius: 20px;
    padding: 6px 14px;
    font-size: 14px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 500;
    color: #222222;
    border: 1px solid #EBEBEB;
  }
  .show-description {
    font-size: 16px;
    line-height: 1.65;
    color: #222222;
    margin: 20px 0;
  }
  .show-price {
    font-size: 22px;
    font-weight: 700;
    color: #222222;
  }
  .btn-owner-edit {
    background: #FF385C !important;
    color: #ffffff !important;
    border-radius: 12px !important;
    padding: 12px 24px !important;
    font-weight: 600 !important;
    font-size: 15px !important;
    text-decoration: none !important;
    border: none !important;
    transition: background-color 0.2s ease !important;
  }
  .btn-owner-edit:hover {
    background: #E31C5F !important;
    color: #ffffff !important;
  }
  .btn-owner-delete {
    background: #ffffff !important;
    color: #222222 !important;
    border: 1px solid #DDDDDD !important;
    border-radius: 12px !important;
    padding: 12px 24px !important;
    font-weight: 600 !important;
    font-size: 15px !important;
    transition: all 0.2s ease !important;
  }
  .btn-owner-delete:hover {
    border-color: #FF385C !important;
    color: #FF385C !important;
    background: #FFF5F6 !important;
  }
  .review-card-form {
    border: 1px solid #DDDDDD;
    border-radius: 16px;
    padding: 24px;
    background: #ffffff;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
  }
  .review-textarea {
    border-radius: 12px !important;
    border: 1px solid #DDDDDD !important;
    padding: 14px 16px !important;
    font-size: 16px !important;
    min-height: 120px;
    color: #222222 !important;
  }
  .review-textarea:focus {
    border-color: #222222 !important;
    box-shadow: 0 0 0 1px #222222 !important;
  }
  .btn-review-submit {
    background: #222222 !important;
    color: #ffffff !important;
    border-radius: 12px !important;
    padding: 12px 24px !important;
    font-weight: 600 !important;
    border: none !important;
    transition: background-color 0.2s ease !important;
  }
  .btn-review-submit:hover {
    background: #000000 !important;
    color: #ffffff !important;
  }
  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }
  .review-item-card {
    border: 1px solid #EEEEEE;
    border-radius: 16px;
    padding: 20px;
    background: #ffffff;
    position: relative;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.02);
  }
  .map-wrapper {
    border-radius: 20px;
    overflow: hidden;
    height: 400px;
    border: 1px solid #EBEBEB;
    width: 100%;
    margin-top: 16px;
  }
  #map {
    height: 100%;
    width: 100%;
  }
</style>

<div class="show-container">
  <!-- Header -->
  <h1 class="show-title"><%= listing.title %></h1>
  <p class="show-location"><i class="bi bi-geo-alt me-1"></i><%= listing.location %>, <%= listing.country %></p>

  <!-- Main Hero Image -->
  <div class="show-img-container">
    <img src="<%= listing.image.url %>" alt="<%= listing.title %>">
  </div>

  <!-- Info Section -->
  <div class="mb-4">
    <div class="owner-pill">
      <i class="bi bi-person-circle fs-6 text-secondary"></i>
      <span>Hosted by <%= listing.owner ? listing.owner.username : "Wanderlust Host" %></span>
    </div>

    <hr style="border-top: 1px solid #EBEBEB; margin: 20px 0;">

    <p class="show-description"><%= listing.description %></p>

    <div class="d-flex align-items-baseline gap-1 my-3">
      <span class="show-price">&#8377;<%= listing.price.toLocaleString("en-IN") %></span>
      <span class="text-secondary" style="font-size: 15px;">/ night</span>
    </div>
  </div>

  <!-- Edit/Delete Actions (Owner Only) -->
  <% if(currUser && listing.owner && listing.owner._id.equals(currUser._id)) { %>
    <div class="d-flex gap-3 my-4">
      <a href="/listings/<%= listing._id %>/edit" class="btn btn-owner-edit">Edit Listing</a>
      <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" onsubmit="return confirm('Are you sure you want to delete this listing?');">
        <button class="btn btn-owner-delete">Delete Listing</button>
      </form>
    </div>
  <% } %>

  <hr style="border-top: 1px solid #EBEBEB; margin: 32px 0;">

  <!-- Reviews Section -->
  <div class="mb-5">
    <div class="d-flex align-items-center justify-content-between mb-3">
      <h4 class="fw-bold text-dark fs-4 mb-0 d-flex align-items-center gap-2">
        <i class="bi bi-star-fill text-dark fs-5"></i> Reviews
      </h4>
    </div>

    <!-- Leave Review Form (If Logged In) -->
    <% if(currUser) { %>
      <div class="review-card-form mb-4">
        <h5 class="fw-semibold text-dark fs-6 mb-3">Leave a Review</h5>
        <form action="/listings/<%= listing._id %>/reviews" method="POST" class="needs-validation" novalidate>
          <div class="mb-3">
            <label for="rating" class="form-label text-secondary small fw-medium">Rating</label>
            <fieldset class="starability-slot">
              <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
              <input type="radio" id="first-rate1" name="review[rating]" value="1" />
              <label for="first-rate1" title="Terrible">1 star</label>
              <input type="radio" id="first-rate2" name="review[rating]" value="2" />
              <label for="first-rate2" title="Not good">2 stars</label>
              <input type="radio" id="first-rate3" name="review[rating]" value="3" />
              <label for="first-rate3" title="Average">3 stars</label>
              <input type="radio" id="first-rate4" name="review[rating]" value="4" />
              <label for="first-rate4" title="Very good">4 stars</label>
              <input type="radio" id="first-rate5" name="review[rating]" value="5" />
              <label for="first-rate5" title="Amazing">5 stars</label>
            </fieldset>
          </div>

          <div class="mb-3">
            <label for="comment" class="form-label text-secondary small fw-medium">Comments</label>
            <textarea name="review[comment]" id="comment" class="form-control review-textarea" placeholder="Share details of your stay..." required></textarea>
            <div class="invalid-feedback small mt-1">Please add comments for your review.</div>
          </div>

          <button class="btn btn-review-submit">Submit Review</button>
        </form>
      </div>
    <% } %>

    <!-- Existing Reviews List -->
    <% if(listing.reviews && listing.reviews.length > 0) { %>
      <div class="reviews-grid">
        <% for(let review of listing.reviews) { %>
          <div class="review-item-card">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <div>
                <h6 class="fw-bold text-dark mb-0">@<%= review.author ? review.author.username : "guest" %></h6>
                <p class="starability-result mt-1 mb-0" data-rating="<%= review.rating %>"></p>
              </div>
              <% if(currUser && review.author && review.author._id.equals(currUser._id)) { %>
                <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                  <button type="submit" class="btn btn-link text-danger p-0 border-0 text-decoration-none small" style="font-size: 13px;">
                    <i class="bi bi-trash"></i>
                  </button>
                </form>
              <% } %>
            </div>
            <p class="text-secondary mb-0" style="font-size: 14px; line-height: 1.5;"><%= review.comment %></p>
          </div>
        <% } %>
      </div>
    <% } else { %>
      <div class="text-center py-4 text-muted bg-light rounded-4 border border-light">
        <i class="bi bi-chat-square-heart fs-2 text-secondary mb-2 d-block"></i>
        <p class="mb-0 fw-medium">No reviews yet for this stay</p>
      </div>
    <% } %>
  </div>

  <hr style="border-top: 1px solid #EBEBEB; margin: 32px 0;">

  <!-- Map Section -->
  <div>
    <h4 class="fw-bold text-dark fs-4 mb-2">Where you'll be staying</h4>
    <p class="text-muted small mb-0"><%= listing.location %>, <%= listing.country %></p>
    <div class="map-wrapper">
      <div id="map"></div>
    </div>
  </div>
</div>

<script src="/js/map.js"></script>
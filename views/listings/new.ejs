<% layout("/layouts/boilerplate") -%>

<style>
  .host-container {
    max-width: 640px;
    margin: 32px auto 64px auto;
    padding: 0 16px;
  }
  .upload-zone {
    border: 2px dashed #DDDDDD;
    border-radius: 20px;
    padding: 40px 24px;
    text-align: center;
    cursor: pointer;
    background-color: #ffffff;
    transition: border-color 0.2s ease, background-color 0.2s ease;
    position: relative;
    overflow: hidden;
  }
  .upload-zone:hover {
    border-color: #222222;
    background-color: #FAFAFA;
  }
  .host-input {
    font-size: 16px !important;
    padding: 14px 16px !important;
    border-radius: 12px !important;
    border: 1px solid #DDDDDD !important;
    color: #222222 !important;
  }
  .host-input:focus,
  .host-textarea:focus,
  .host-price-input:focus {
    border-color: #222222 !important;
    box-shadow: 0 0 0 1px #222222 !important;
  }
  .host-textarea {
    font-size: 16px !important;
    padding: 14px 16px !important;
    border-radius: 12px !important;
    border: 1px solid #DDDDDD !important;
    min-height: 140px;
    color: #222222 !important;
  }
  .host-price-input {
    font-size: 20px !important;
    font-weight: 600 !important;
    padding: 14px 16px 14px 38px !important;
    border-radius: 12px !important;
    border: 1px solid #DDDDDD !important;
    color: #222222 !important;
  }
  .location-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  @media (max-width: 600px) {
    .location-grid {
      grid-template-columns: 1fr;
    }
  }
  .host-submit-btn {
    background: #FF385C !important;
    color: #ffffff !important;
    border-radius: 12px !important;
    padding: 16px !important;
    font-weight: 600 !important;
    font-size: 16px !important;
    width: 100%;
    border: none !important;
    transition: background-color 0.2s ease !important;
  }
  .host-submit-btn:hover {
    background: #E31C5F !important;
    color: #ffffff !important;
  }
  .form-section {
    margin-bottom: 32px;
  }
</style>

<div class="host-container">
  <!-- Page Header -->
  <div class="mb-4">
    <h1 class="fw-bold text-dark fs-2 mb-1" style="letter-spacing: -0.5px;">Tell us about your place</h1>
    <p class="text-muted fs-6 mb-0">Share some basic info to get started</p>
  </div>

  <form action="/listings" method="POST" novalidate class="needs-validation" enctype="multipart/form-data">
    
    <!-- 1. Photo Upload Zone -->
    <div class="form-section">
      <label class="form-label fw-bold text-dark fs-6 mb-2">Listing Photo</label>
      <div class="upload-zone" id="upload-zone" onclick="document.getElementById('image-file-input').click()">
        <div id="upload-prompt" class="d-flex flex-column align-items-center justify-content-center text-center">
          <i class="bi bi-camera fs-1 text-secondary mb-2"></i>
          <span class="fw-bold text-dark fs-6">Add a photo of your place</span>
          <span class="text-muted small mt-1">Choose a high quality photo that shows off your space</span>
        </div>
        <div id="upload-preview-container" class="d-none position-relative w-100 h-100">
          <img id="upload-preview-img" src="" alt="Upload Preview" class="w-100 rounded-3 object-fit-cover" style="max-height: 320px;">
          <div class="position-absolute bottom-0 start-50 translate-middle-x mb-3 bg-dark text-white px-3 py-1 rounded-pill small opacity-75">Click to change photo</div>
        </div>
      </div>
      <input type="file" name="listing[image]" id="image-file-input" class="d-none" accept="image/*" required onchange="previewSelectedImage(this)">
      <div class="invalid-feedback small mt-1">Please select an image for your listing.</div>
    </div>

    <!-- 2. Title -->
    <div class="form-section">
      <label for="title" class="form-label fw-bold text-dark fs-6 mb-2">What's the name of your place?</label>
      <input type="text" id="title" name="listing[title]" placeholder="e.g. Cozy Beachfront Villa in Goa" class="form-control host-input" required>
      <div class="invalid-feedback small mt-1">Please enter a catchy title.</div>
    </div>

    <!-- 3. Description -->
    <div class="form-section">
      <label for="description" class="form-label fw-bold text-dark fs-6 mb-2">Create your description</label>
      <textarea id="description" name="listing[description]" placeholder="Describe what makes your space special, nearby attractions, view, amenities..." class="form-control host-textarea" required></textarea>
      <div class="d-flex justify-content-between mt-1">
        <div class="invalid-feedback small">Please enter a description.</div>
        <span class="text-muted ms-auto" style="font-size: 12px;">Include details about view, space & amenities</span>
      </div>
    </div>

    <!-- 4. Category -->
    <div class="form-section">
      <label for="category" class="form-label fw-bold text-dark fs-6 mb-2">Choose a category</label>
      <select id="category" name="listing[category]" class="form-select host-input" required>
        <option value="trending" selected>🔥 Trending</option>
        <option value="rooms">🛏️ Rooms</option>
        <option value="iconic_cities">🏙️ Iconic Cities</option>
        <option value="mountains">⛰️ Mountains</option>
        <option value="castles">🏰 Castles</option>
        <option value="amazing_pools">🏊 Amazing Pools</option>
        <option value="camping">⛺ Camping</option>
        <option value="farms">🚜 Farms</option>
        <option value="arctic">❄️ Arctic</option>
        <option value="domes">🛖 Domes</option>
        <option value="boats">⛵ Boats</option>
      </select>
    </div>

    <!-- 5. Price -->
    <div class="form-section">
      <label for="price" class="form-label fw-bold text-dark fs-6 mb-2">Set your price</label>
      <div class="position-relative">
        <span class="position-absolute top-50 start-0 translate-middle-y ms-3 fw-bold text-dark" style="font-size: 20px; z-index: 5;">₹</span>
        <input type="number" id="price" name="listing[price]" placeholder="1200" class="form-control host-price-input" min="0" required>
      </div>
      <div class="form-text text-muted mt-1" style="font-size: 12px;">Nightly rate before taxes</div>
      <div class="invalid-feedback small mt-1">Please enter a valid price per night.</div>
    </div>

    <!-- 6. Location & Country (2-column responsive grid) -->
    <div class="form-section">
      <div class="location-grid">
        <div>
          <label for="location" class="form-label fw-bold text-dark fs-6 mb-2">Location / City</label>
          <input type="text" id="location" name="listing[location]" placeholder="e.g. Anjuna, Goa" class="form-control host-input" required>
          <div class="invalid-feedback small mt-1">Please enter a location.</div>
        </div>
        <div>
          <label for="country" class="form-label fw-bold text-dark fs-6 mb-2">Country</label>
          <input type="text" id="country" name="listing[country]" placeholder="e.g. India" class="form-control host-input" required>
          <div class="invalid-feedback small mt-1">Please enter a country.</div>
        </div>
      </div>
    </div>

    <!-- Submit Button -->
    <div class="mt-4">
      <button class="btn host-submit-btn" type="submit">Create Listing</button>
    </div>

  </form>
</div>

<script>
  function previewSelectedImage(input) {
    if (input.files && input.files[0]) {
      const reader = new FileReader();
      reader.onload = function(e) {
        document.getElementById('upload-prompt').classList.add('d-none');
        const previewContainer = document.getElementById('upload-preview-container');
        const previewImg = document.getElementById('upload-preview-img');
        previewImg.src = e.target.result;
        previewContainer.classList.remove('d-none');
      }
      reader.readAsDataURL(input.files[0]);
    }
  }
</script>
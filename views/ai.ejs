<% layout("/layouts/boilerplate") -%>

<style>
  .markdown-body h1,
  .markdown-body h2,
  .markdown-body h3,
  .markdown-body h4,
  .markdown-body h5,
  .markdown-body h6 {
    font-size: 1.1rem !important;
    font-weight: 700 !important;
    margin-top: 0.75rem !important;
    margin-bottom: 0.5rem !important;
    color: #222222 !important;
  }

  .markdown-body p {
    font-size: 0.95rem !important;
    line-height: 1.5 !important;
    color: #222222 !important;
    margin-bottom: 0.5rem !important;
  }

  .markdown-body ul,
  .markdown-body ol {
    margin-bottom: 0.5rem !important;
    padding-left: 1.25rem !important;
  }

  .markdown-body li {
    font-size: 0.95rem !important;
    line-height: 1.5 !important;
    color: #222222 !important;
    margin-bottom: 0.25rem !important;
  }

  .chatgpt-page-container {
    max-width: 900px;
    margin: 1.5rem auto;
    height: 80vh;
    display: flex;
    flex-direction: column;
    background-color: #F9F9F9;
    border-radius: 1.5rem;
    border: 1px solid #e2e8f0;
    box-shadow: 0 10px 30px rgba(0,0,0,0.05);
    overflow: hidden;
  }

  .chatgpt-header {
    background: #ffffff;
    border-bottom: 1px solid #e2e8f0;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .chatgpt-history {
    flex: 1;
    overflow-y: auto;
    padding: 1.5rem;
    scroll-behavior: smooth;
  }

  .chatgpt-input-area {
    background: #ffffff;
    border-top: 1px solid #e2e8f0;
    padding: 1rem 1.5rem;
  }

  .chip-btn {
    border: 1px solid #e2e8f0;
    background: #ffffff;
    border-radius: 20px;
    padding: 0.4rem 0.9rem;
    font-size: 0.85rem;
    color: #475569;
    cursor: pointer;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .chip-btn:hover {
    border-color: #FF385C;
    color: #FF385C;
    background: #fff5f6;
  }
</style>

<div class="chatgpt-page-container">
  <!-- Header -->
  <div class="chatgpt-header">
    <div class="d-flex align-items-center gap-3">
      <div class="rounded-circle d-flex align-items-center justify-content-center text-white" style="width: 40px; height: 40px; background-color: #FF385C;">
        <i class="bi bi-sparkles fs-5"></i>
      </div>
      <div>
        <h5 class="fw-bold text-dark mb-0 fs-6">Wanderlust AI Assistant</h5>
        <small class="text-muted" style="font-size: 0.78rem;">Powered by Gemini 3.6 Flash</small>
      </div>
    </div>
    <span class="badge bg-light text-dark border px-3 py-2 rounded-pill"><i class="bi bi-circle-fill text-success me-1" style="font-size: 0.6rem;"></i> Live AI Companion</span>
  </div>

  <!-- Scrollable Chat History Area -->
  <div class="chatgpt-history" id="page-chat-history">
    
    <!-- Welcome AI Message Bubble -->
    <div class="p-3 bg-white border border-light rounded-4 mb-3 float-start clear-both w-100 shadow-sm">
      <div class="fw-semibold text-dark mb-1 d-flex align-items-center gap-2">
        <i class="bi bi-robot" style="color: #FF385C;"></i> Wanderlust AI
      </div>
      <p class="mb-0 text-secondary" style="color: #222222; font-size: 0.95rem; line-height: 1.55;">
        Hello! I'm your Wanderlust travel companion. Ask me for custom itineraries, local hidden gems, flight advice, or destination tips!
      </p>
    </div>

  </div>

  <!-- Quick Suggestion Chips -->
  <div class="px-4 py-2 bg-light border-top border-bottom d-flex flex-wrap gap-2 align-items-center">
    <span class="text-muted small me-1">Suggestions:</span>
    <button class="chip-btn" onclick="quickAskPage('3-day travel itinerary for Paris')"><i class="bi bi-map"></i> 3-Day Paris Itinerary</button>
    <button class="chip-btn" onclick="quickAskPage('Best tropical beach destinations')"><i class="bi bi-sun"></i> Tropical Beaches</button>
    <button class="chip-btn" onclick="quickAskPage('Budget packing tips for solo travelers')"><i class="bi bi-bag"></i> Solo Travel Tips</button>
  </div>

  <!-- Fixed Input Container -->
  <div class="chatgpt-input-area">
    <div class="position-relative">
      <input type="text" id="page-chat-input" class="form-control rounded-pill border shadow-sm px-4 py-3 bg-white w-100" placeholder="Ask Wanderlust AI anything..." style="padding-right: 55px !important; font-size: 0.95rem; color: #222222;" />
      <button type="button" id="page-chat-send-btn" class="btn p-0 border-0 position-absolute end-0 top-50 translate-middle-y me-3" style="color: #FF385C; background: transparent;" onclick="sendPageChatMessage()">
        <i class="bi bi-send-fill fs-5"></i>
      </button>
    </div>
  </div>
</div>

<script>
  function quickAskPage(text) {
    document.getElementById("page-chat-input").value = text;
    sendPageChatMessage();
  }

  function escapeHtmlPage(text) {
    const div = document.createElement("div");
    div.textContent = text;
    return div.innerHTML;
  }

  async function sendPageChatMessage() {
    const inputEl = document.getElementById("page-chat-input");
    const userText = inputEl.value.trim();
    if (!userText) return;

    const chatHistory = document.getElementById("page-chat-history");
    const sendBtn = document.getElementById("page-chat-send-btn");

    inputEl.value = "";
    inputEl.disabled = true;
    sendBtn.disabled = true;

    // 1. Append USER Message Bubble
    const userBubble = document.createElement("div");
    userBubble.className = "w-100 float-end clear-both mb-3 text-end";
    userBubble.innerHTML = `
      <div class="rounded-start-4 rounded-top-4 rounded-bottom-1 px-3 py-2 text-white bg-dark d-inline-block text-start shadow-sm" style="max-width: 80%; background-color: #222222 !important; font-size: 0.95rem;">
        ${escapeHtmlPage(userText)}
      </div>
    `;
    chatHistory.appendChild(userBubble);
    chatHistory.scrollTop = chatHistory.scrollHeight;

    // 2. Append AI Typing Indicator Bubble
    const loadingBubble = document.createElement("div");
    loadingBubble.className = "p-3 bg-white border border-light rounded-4 mb-3 float-start clear-both w-100 shadow-sm";
    loadingBubble.id = "page-ai-loading-bubble";
    loadingBubble.innerHTML = `
      <div class="d-flex align-items-center gap-2 text-muted">
        <div class="spinner-grow spinner-grow-sm" role="status" style="color: #FF385C !important;"></div>
        <span class="small text-secondary fw-medium">Wanderlust AI is writing...</span>
      </div>
    `;
    chatHistory.appendChild(loadingBubble);
    chatHistory.scrollTop = chatHistory.scrollHeight;

    try {
      const res = await fetch("/api/ai-assistant", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ prompt: userText })
      });
      const data = await res.json();

      const loader = document.getElementById("page-ai-loading-bubble");
      if (loader) loader.remove();

      // 3. Append AI Response Bubble
      const aiBubble = document.createElement("div");
      aiBubble.className = "p-3 bg-white border border-light rounded-4 mb-3 float-start clear-both w-100 shadow-sm";
      const formattedHtml = typeof marked !== "undefined" ? marked.parse(data.text || "") : escapeHtmlPage(data.text || "");
      aiBubble.innerHTML = `
        <div class="fw-semibold text-dark mb-2 d-flex align-items-center gap-2">
          <i class="bi bi-robot" style="color: #FF385C;"></i> Wanderlust AI
        </div>
        <div class="markdown-body" style="color: #222222; font-size: 0.95rem; line-height: 1.6;">
          ${formattedHtml}
        </div>
      `;
      chatHistory.appendChild(aiBubble);
    } catch (err) {
      console.error(err);
      const loader = document.getElementById("page-ai-loading-bubble");
      if (loader) loader.remove();

      const errorBubble = document.createElement("div");
      errorBubble.className = "p-3 bg-white border border-light rounded-4 mb-3 float-start clear-both w-100 text-danger shadow-sm";
      errorBubble.innerHTML = "Oops! Something went wrong while connecting to Wanderlust AI. Please try again.";
      chatHistory.appendChild(errorBubble);
    } finally {
      inputEl.disabled = false;
      sendBtn.disabled = false;
      inputEl.focus();
      chatHistory.scrollTop = chatHistory.scrollHeight;
    }
  }

  document.getElementById("page-chat-input")?.addEventListener("keypress", function (e) {
    if (e.key === "Enter") {
      sendPageChatMessage();
    }
  });
</script>

<% layout("/layouts/boilerplate") -%>

<div class="container-fluid site-wrapper auth-page-wrapper">
  <div class="auth-card">
    
    <!-- Brand Logo Header -->
    <div class="text-center mb-4">
      <i class="bi bi-geo-alt-fill" style="color: #FF385C; font-size: 28px;"></i>
      <div class="fw-bold" style="color: #FF385C; font-size: 22px;">wanderlust</div>
      <h2 class="fw-bold text-dark mt-2 mb-0" style="font-size: 1.5rem;">Sign up</h2>
    </div>

    <form action="/signup" method="post" class="needs-validation" novalidate>
      <!-- Username Input -->
      <div class="mb-3">
        <label for="username" class="form-label fw-semibold text-dark small">Username</label>
        <input type="text" id="username" name="username" placeholder="Choose a username" class="form-control auth-input" required>
        <div class="invalid-feedback small">Please enter a username.</div>
      </div>

      <!-- Email Input -->
      <div class="mb-3">
        <label for="email" class="form-label fw-semibold text-dark small">Email</label>
        <input type="email" id="email" name="email" placeholder="name@example.com" class="form-control auth-input" required>
        <div class="invalid-feedback small">Please enter a valid email address.</div>
      </div>

      <!-- Password Input with Eye Toggle & Helper Text -->
      <div class="mb-4">
        <label for="password" class="form-label fw-semibold text-dark small">Password</label>
        <div class="position-relative">
          <input type="password" id="password" name="password" placeholder="Create a password" class="form-control auth-input pe-5" minlength="8" required>
          <button type="button" class="btn border-0 position-absolute top-50 end-0 translate-middle-y me-2 text-muted" onclick="togglePasswordVisibility('password', this)">
            <i class="bi bi-eye fs-5"></i>
          </button>
        </div>
        <div class="form-text text-muted mt-1" style="font-size: 12px;">Password must be at least 8 characters</div>
        <div class="invalid-feedback small">Password must be at least 8 characters.</div>
      </div>

      <!-- Primary Red Button -->
      <button class="btn auth-btn-primary mb-4" type="submit">Sign up</button>

      <!-- Footer Login Link -->
      <div class="text-center small text-muted">
        Already have an account? <a href="/login" class="text-dark fw-bold text-decoration-underline ms-1">Log in</a>
      </div>
    </form>

  </div>
</div>

<script>
  function togglePasswordVisibility(inputId, btn) {
    const input = document.getElementById(inputId);
    const icon = btn.querySelector('i');
    if (input.type === 'password') {
      input.type = 'text';
      icon.className = 'bi bi-eye-slash fs-5';
    } else {
      input.type = 'password';
      icon.className = 'bi bi-eye fs-5';
    }
  }
</script>